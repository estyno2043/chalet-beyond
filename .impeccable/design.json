      "refersTo": "roll-ghost",
      "description": "Preserved small ghost playback tone; application supplies playback state.",
      "html": "<button type=\"button\" class=\"ds-roll-ghost\"><span class=\"ds-roll-ghost-fill\" aria-hidden=\"true\"></span><span class=\"ds-roll-ghost-label\"><span class=\"ds-roll-ghost-row\">Prehrať video</span><span class=\"ds-roll-ghost-row ds-roll-ghost-next\" aria-hidden=\"true\">Prehrať video</span></span></button>",
      "css": ".ds-roll-ghost{--ds-bg:rgb(12 14 12 / .3);--ds-fg:oklch(.97 .007 75);--ds-line:rgb(245 244 239 / .32);--ds-fill:oklch(.97 .007 75);--ds-fill-fg:oklch(.12 .01 55);position:relative;isolation:isolate;display:inline-flex;align-items:center;justify-content:center;height:58px;padding:0 30px;overflow:hidden;border:0;border-radius:999px;background:var(--ds-bg);box-shadow:inset 0 0 0 1px var(--ds-line);color:var(--ds-fg);font:700 .78125rem/1 var(--font-body-family,\"Karla\",sans-serif);letter-spacing:.16em;text-transform:uppercase;text-decoration:none;white-space:nowrap;cursor:pointer;transition:transform 160ms ease-out,background-color 480ms var(--ease-enter,cubic-bezier(.16,1,.3,1));}.ds-roll-ghost{height:44px;padding:0 22px;font-size:.71875rem;letter-spacing:.14em;}.ds-roll-ghost-fill{position:absolute;z-index:-1;top:0;left:-15%;width:130%;height:260%;border-radius:50%;background:var(--ds-fill);transform:translate3d(0,40%,0);transition:transform 560ms var(--ease-enter,cubic-bezier(.16,1,.3,1));} .ds-roll-ghost-label{position:relative;display:block;overflow:hidden;padding-block:.35em;} .ds-roll-ghost-row{display:flex;align-items:center;justify-content:center;transition:transform 560ms var(--ease-enter,cubic-bezier(.16,1,.3,1));} .ds-roll-ghost-next{position:absolute;inset:0;color:var(--ds-fill-fg);transform:translate3d(0,calc(100% + .6em),0);transition-delay:30ms;} .ds-roll-ghost:active{transform:scale(.98);} .ds-roll-ghost:focus-visible{outline:2px solid oklch(.97 .007 75);outline-offset:4px;} .ds-roll-ghost:focus-visible .ds-roll-ghost-fill{transform:translate3d(0,-31%,0);} .ds-roll-ghost:focus-visible .ds-roll-ghost-row{transform:translate3d(0,calc(-100% - .6em),0);} .ds-roll-ghost:focus-visible .ds-roll-ghost-next{transform:translate3d(0,0,0);} @media(hover:hover) and (pointer:fine){.ds-roll-ghost:hover .ds-roll-ghost-fill{transform:translate3d(0,-31%,0);} .ds-roll-ghost:hover .ds-roll-ghost-row{transform:translate3d(0,calc(-100% - .6em),0);} .ds-roll-ghost:hover .ds-roll-ghost-next{transform:translate3d(0,0,0);}} @media(prefers-reduced-motion:reduce){.ds-roll-ghost{transition:background-color 240ms,color 240ms;} .ds-roll-ghost-fill{display:none;} .ds-roll-ghost-row{transition:none!important;transform:none!important;} .ds-roll-ghost-next{visibility:hidden;} .ds-roll-ghost:hover,.ds-roll-ghost:focus-visible{background:var(--ds-fill);color:var(--ds-fill-fg);} .ds-roll-ghost:active{transform:none;}}"
    },
    {
      "name": "Desktop navigation link",
      "kind": "nav",
      "refersTo": "navigation-link",
      "description": "Karla link with a directional amber underline; full links appear from 1280px.",
      "html": "<nav aria-label=\"Navigation sample\"><a href=\"#priestory\" class=\"ds-nav-link\">Priestory</a></nav>",
      "css": ".ds-nav-link{position:relative;display:inline-flex;align-items:center;min-height:44px;padding:6px 12px;font:500 .875rem/1 var(--font-body-family,\"Karla\",sans-serif);letter-spacing:.01em;color:rgb(245 244 239 / .82);text-decoration:none;transition:color 180ms ease-out;}.ds-nav-link::after{content:\"\";position:absolute;left:12px;right:12px;bottom:8px;height:1px;background:var(--amber,oklch(.72 .12 65));transform:scaleX(0);transform-origin:right;transition:transform 320ms var(--ease-enter,cubic-bezier(.16,1,.3,1));}.ds-nav-link:hover{color:oklch(.97 .007 75);}.ds-nav-link:hover::after{transform:scaleX(1);transform-origin:left;}.ds-nav-link:focus-visible{outline:2px solid oklch(.97 .007 75);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-nav-link,.ds-nav-link::after{transition:none;}}"
    },
    {
      "name": "Language trigger",
      "kind": "button",
      "refersTo": "language-trigger",
      "description": "Pill dropdown trigger; flag is paired with text in the application.",
      "html": "<button type=\"button\" class=\"ds-language\" aria-haspopup=\"menu\" aria-expanded=\"false\">SK<svg width=\"11\" height=\"11\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m6 9 6 6 6-6\"/></svg></button>",
      "css": ".ds-language{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:44px;padding:0 16px;border:0;border-radius:999px;box-shadow:inset 0 0 0 1px rgb(245 244 239 / .24);background:transparent;color:oklch(.97 .007 75);font:600 .75rem/1 var(--font-body-family,\"Karla\",sans-serif);letter-spacing:.06em;cursor:pointer;transition:background var(--motion-ui,160ms) var(--ease-ui,cubic-bezier(.23,1,.32,1));}.ds-language[aria-expanded=\"true\"]{background:rgb(245 244 239 / .08);}.ds-language:hover{background:rgb(245 244 239 / .08);}.ds-language:focus-visible{outline:2px solid oklch(.97 .007 75);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-language{transition:none;}}"
    },
    {
      "name": "Inquiry field",
      "kind": "input",
      "refersTo": "inquiry-field",
      "description": "Visible label, transparent field, quiet edge and amber caret.",
      "html": "<label class=\"ds-field-label\" for=\"ds-name\">Meno</label><input id=\"ds-name\" class=\"ds-field\" name=\"name\" autocomplete=\"name\"/>",
      "css": ".ds-field-label{display:block;font:400 1rem/1.65 var(--font-body-family,\"Karla\",sans-serif);color:var(--foreground,oklch(.92 .008 75));margin-bottom:8px;}.ds-field{width:100%;min-height:48px;border:1px solid rgb(245 244 239 / .4);background:transparent;border-radius:3px;color:var(--foreground,oklch(.92 .008 75));padding:10px 12px;font:400 1rem/1.5 var(--font-body-family,\"Karla\",sans-serif);caret-color:var(--amber,oklch(.72 .12 65));}.ds-field:focus-visible{outline:2px solid var(--foreground,oklch(.92 .008 75));outline-offset:5px;}"
    },
    {
      "name": "Guest control",
      "kind": "custom",
      "refersTo": "guest-control",
      "description": "44px circular controls with a tabular output; app supplies shared state/capacity.",
      "html": "<div class=\"ds-guest\"><span id=\"ds-guest-label\">Dospelí (16+)</span><div class=\"ds-guest-controls\" role=\"group\" aria-labelledby=\"ds-guest-label\"><button type=\"button\" aria-label=\"− Dospelí (16+)\">−</button><output>2</output><button type=\"button\" aria-label=\"+ Dospelí (16+)\">+</button></div></div>",
      "css": ".ds-guest{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:64px;font:400 1.0625rem/1.65 var(--font-body-family,\"Karla\",sans-serif);color:var(--foreground,oklch(.92 .008 75));}.ds-guest-controls{display:flex;align-items:center;gap:12px;flex-shrink:0;}.ds-guest button{width:44px;height:44px;border:1px solid rgb(245 244 239 / .4);border-radius:50%;font-size:1.375rem;line-height:1;color:inherit;background:transparent;cursor:pointer;transition:transform var(--motion-ui,160ms) var(--ease-ui,cubic-bezier(.23,1,.32,1)),background var(--motion-ui,160ms);}.ds-guest button:disabled{opacity:.4;cursor:default;}.ds-guest button:active:not(:disabled){transform:scale(.95);}.ds-guest button:focus-visible{outline:2px solid var(--foreground,oklch(.92 .008 75));outline-offset:5px;}.ds-guest output{min-width:24px;text-align:center;font-variant-numeric:tabular-nums;font-size:1.25rem;}@media(hover:hover) and (pointer:fine){.ds-guest button:hover:not(:disabled){background:rgb(245 244 239 / .12);}}@media(prefers-reduced-motion:reduce){.ds-guest button:active:not(:disabled){transform:none;}}"
    },
    {
      "name": "Calendar day",
      "kind": "button",
      "refersTo": "calendar-day",
      "description": "44px selected endpoint; range middle uses translucent amber. App supplies date logic.",
      "html": "<button type=\"button\" class=\"ds-day\" aria-pressed=\"true\" aria-label=\"Vybraný dátum\">14</button>",
      "css": ".ds-day{display:inline-grid;place-items:center;width:44px;height:44px;border:0;border-radius:50%;background:var(--amber,oklch(.72 .12 65));color:var(--background,oklch(.06 .008 55));font:500 1rem/1 var(--font-body-family,\"Karla\",sans-serif);cursor:pointer;transition:transform var(--motion-ui,160ms) var(--ease-ui,cubic-bezier(.23,1,.32,1));}.ds-day[aria-pressed=\"false\"]{background:transparent;color:var(--foreground,oklch(.92 .008 75));}.ds-day:hover{background:var(--amber,oklch(.72 .12 65));}.ds-day:active{transform:scale(.95);}.ds-day:focus-visible{outline:2px solid var(--foreground,oklch(.92 .008 75));outline-offset:5px;}.ds-day:disabled{opacity:.38;}@media(prefers-reduced-motion:reduce){.ds-day:active{transform:none;}}"
    },
    {
      "name": "Gallery cover caption",
      "kind": "custom",
      "refersTo": "gallery-cover",
      "description": "Caption and open affordance extracted without external imagery; application pairs them with owner photographs.",
      "html": "<button type=\"button\" class=\"ds-cover\"><span class=\"ds-cover-open\" aria-hidden=\"true\"><svg width=\"20\" height=\"20\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M7 7h10v10M7 17 17 7\"/></svg></span><span class=\"ds-cover-caption\"><span class=\"ds-cover-title\">Interiér</span><span class=\"ds-cover-description\">Obývačka s kozubom</span></span></button>",
      "css": ".ds-cover{position:relative;display:block;width:100%;min-height:260px;overflow:clip;border:0;border-radius:3px;text-align:left;background:rgb(255 255 255 / .04);padding:0;color:oklch(.97 .007 75);isolation:isolate;cursor:pointer;}.ds-cover::before{content:\"\";position:absolute;inset:0;background:linear-gradient(180deg,transparent 35%,rgb(0 0 0 / .78));}.ds-cover-caption{position:absolute;bottom:24px;left:24px;right:24px;}.ds-cover-title{display:block;font:600 2.5rem/1 var(--font-display-family,\"Thunder\",sans-serif);margin-bottom:8px;}.ds-cover-description{display:block;font:400 1rem/1.4 var(--font-body-family,\"Karla\",sans-serif);}.ds-cover-open{position:absolute;top:16px;right:16px;width:40px;height:40px;display:grid;place-items:center;border:1px solid rgb(255 255 255 / .6);border-radius:50%;color:white;font:400 1.5rem/1 var(--font-body-family,\"Karla\",sans-serif);background:rgb(0 0 0 / .2);}.ds-cover:active .ds-cover-open{transform:scale(.95);}.ds-cover:focus-visible{outline:2px solid var(--foreground,oklch(.92 .008 75));outline-offset:5px;}@media(prefers-reduced-motion:reduce){.ds-cover:active .ds-cover-open{transform:none;}}"
    }
  ],
  "narrative": {
    "northStar": "Dark Timber",
    "overview": "The established Dark Timber identity pairs a near-black ground, pale type and the existing chalet logo with real property photography. The owner-approved premium refinement lets the chalet carry the page: generous space, condensed headings, quiet prose and functional controls.\n\nThe hero retains its supplied footage, two-tone property name and authored letter entrance. Below it, the same identity becomes an editorial sequence of rooms, amenities, location and a direct inquiry. Motion clarifies arrival, image changes and user input; it does not add ornaments.",
    "keyCharacteristics": [
      "A continuous dark ground with photography carrying the product.",
      "Thunder headings, Karla prose and JetBrains Mono for actual tabular price data.",
      "Amber for actions, money and calendar selection below the hero.",
      "Stationary action targets, visible focus and reduced-motion alternatives."
    ],
    "rules": [
      {
        "name": "The Functional Amber Rule",
        "body": "Below the hero, amber marks actions, money and calendar selection. Keep editorial prose and descriptive headings neutral; retain the existing hero and navigation exceptions.",
        "section": "colors"
      },
      {
        "name": "The Real Property Rule",
        "body": "Use the owner-selected chalet photographs with truthful localized descriptions. Preserve the originals and do not substitute stock or generated interiors.",
        "section": "components"
      },
      {
        "name": "The Motion Purpose Rule",
        "body": "Use the shared motion vocabulary for content arrival and functional state changes. Add no new cursor effect, ornamental panel, counting number, glow or magnetic action below the hero.",
        "section": "components"
      }
    ],
    "dos": [
      "Do retain the existing logo and the Thunder, Karla and JetBrains Mono role separation.",
      "Do keep photographs, heading masks and motion wrappers separate so effects do not overwrite one another.",
      "Do preserve 44px calendar and guest controls, visible focus and reduced-motion behavior.",
      "Do keep prices and inquiry details consistent with the shared pricing and guest state.",
      "Do preserve the hero composition and its specific entrance as an existing authored exception."
    ],
    "donts": [
      "Don't reintroduce Bebas Neue, legacy amber/ghost button utilities or decorative glow.",
      "Don't turn descriptive sections into repeated bordered cards or add new ornaments below the hero.",
      "Don't make the hero's two-line title, local sand color or lower-left composition mandatory for every section.",
      "Don't invent ratings, distances, payment conditions, response times or instant-booking guarantees.",
      "Don't gate hero autoplay on network guesses; Save-Data and reduced motion remain the opt-outs."
    ]
  }
}
