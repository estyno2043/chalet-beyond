t{transform:translate3d(0,0,0);}} @media(prefers-reduced-motion:reduce){.ds-roll-solid{transition:background-color 240ms,color 240ms;} .ds-roll-solid-fill{display:none;} .ds-roll-solid-row{transition:none!important;transform:none!important;} .ds-roll-solid-next{visibility:hidden;} .ds-roll-solid:hover,.ds-roll-solid:focus-visible{background:var(--ds-fill);color:var(--ds-fill-fg);} .ds-roll-solid:active{transform:none;}}"
