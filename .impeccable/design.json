    {
      "name": "RollButton outline",
      "kind": "button",
      "refersTo": "roll-outline",
      "description": "Hero outline tone; amber rising fill.",
      "html": "<button type=\"button\" class=\"ds-roll-outline\"><span class=\"ds-roll-outline-fill\" aria-hidden=\"true\"></span><span class=\"ds-roll-outline-label\"><span class=\"ds-roll-outline-row\">Overiť dostupnosť</span><span class=\"ds-roll-outline-row ds-roll-outline-next\" aria-hidden=\"true\">Overiť dostupnosť</span></span></button>",
      "css": ".ds-roll-outline{--ds-bg:transparent;--ds-fg:oklch(.97 .007 75);--ds-line:rgb(245 244 239 / .5);--ds-fill:oklch(.72 .12 65);--ds-fill-fg:oklch(.12 .01 55);position:relative;isolation:isolate;display:inline-flex;align-items:center;justify-content:center;height:58px;padding:0 30px;overflow:hidden;border:0;border-radius:999px;background:var(--ds-bg);box-shadow:inset 0 0 0 1px var(--ds-line);color:var(--ds-fg);font:700 .78125rem/1 var(--font-body-family,\"Karla\",sans-serif);letter-spacing:.16em;text-transform:uppercase;text-decoration:none;white-space:nowrap;cursor:pointer;transition:transform 160ms ease-out,background-color 480ms var(--ease-enter,cubic-bezier(.16,1,.3,1));}.ds-roll-outline-fill{position:absolute;z-index:-1;top:0;left:-15%;width:130%;height:260%;border-radius:50%;background:var(--ds-fill);transform:translate3d(0,40%,0);transition:transform 560ms var(--ease-enter,cubic-bezier(.16,1,.3,1));} .ds-roll-outline-label{position:relative;display:block;overflow:hidden;padding-block:.35em;} .ds-roll-outline-row{display:flex;align-items:center;justify-content:center;transition:transform 560ms var(--ease-enter,cubic-bezier(.16,1,.3,1));} .ds-roll-outline-next{position:absolute;inset:0;color:var(--ds-fill-fg);transform:translate3d(0,calc(100% + .6em),0);transition-delay:30ms;} .ds-roll-outline:active{transform:scale(.98);} .ds-roll-outline:focus-visible{outline:2px solid oklch(.97 .007 75);outline-offset:4px;} .ds-roll-outline:focus-visible .ds-roll-outline-fill{transform:translate3d(0,-31%,0);} .ds-roll-outline:focus-visible .ds-roll-outline-row{transform:translate3d(0,calc(-100% - .6em),0);} .ds-roll-outline:focus-visible .ds-roll-outline-next{transform:translate3d(0,0,0);} @media(hover:hover) and (pointer:fine){.ds-roll-outline:hover .ds-roll-outline-fill{transform:translate3d(0,-31%,0);} .ds-roll-outline:hover .ds-roll-outline-row{transform:translate3d(0,calc(-100% - .6em),0);} .ds-roll-outline:hover .ds-roll-outline-next{transform:translate3d(0,0,0);}} @media(prefers-reduced-motion:reduce){.ds-roll-outline{transition:background-color 240ms,color 240ms;} .ds-roll-outline-fill{display:none;} .ds-roll-outline-row{transition:none!important;transform:none!important;} .ds-roll-outline-next{visibility:hidden;} .ds-roll-outline:hover,.ds-roll-outline:focus-visible{background:var(--ds-fill);color:var(--ds-fill-fg);} .ds-roll-outline:active{transform:none;}}"
    },
    {
